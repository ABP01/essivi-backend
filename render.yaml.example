# Render Deployment Configuration
# Copy this to render.yaml and adjust values

services:
  - type: web
    name: essivi-backend
    runtime: docker
    dockerfilePath: ./infrastructure/docker/Dockerfile
    healthCheckPath: /health/
    envVars:
      - key: DEBUG
        value: false
      - key: DJANGO_SETTINGS_MODULE
        value: core.settings
      - key: SECRET_KEY
        generateValue: true  # Render will generate a secure key
      - key: ALLOWED_HOSTS
        fromSecret: ALLOWED_HOSTS  # Set this in Render dashboard
      # Database Configuration (Supabase)
      - key: POSTGRES_DB
        value: postgres
      - key: POSTGRES_USER
        fromSecret: POSTGRES_USER
      - key: POSTGRES_PASSWORD
        fromSecret: POSTGRES_PASSWORD
      - key: POSTGRES_HOST
        fromSecret: POSTGRES_HOST
      - key: POSTGRES_PORT
        value: 5432
      # MongoDB Atlas
      - key: MONGO_URI
        fromSecret: MONGO_URI
      - key: MONGO_DB_NAME
        value: essivi_analytics
      # Redis Cloud
      - key: REDIS_HOST
        fromSecret: REDIS_HOST
      - key: REDIS_PORT
        fromSecret: REDIS_PORT
      - key: REDIS_USERNAME
        value: default
      - key: REDIS_PASSWORD
        fromSecret: REDIS_PASSWORD
      - key: REDIS_DB
        value: 0
      - key: REDIS_DECODE_RESPONSES
        value: true
      # Appwrite Configuration
      - key: APPWRITE_ENDPOINT
        value: https://cloud.appwrite.io/v1
      - key: APPWRITE_PROJECT_ID
        fromSecret: APPWRITE_PROJECT_ID
      - key: APPWRITE_API_KEY
        fromSecret: APPWRITE_API_KEY
      # CORS Configuration
      - key: CORS_ALLOWED_ORIGINS
        fromSecret: CORS_ALLOWED_ORIGINS