# ===================================
# BACKEND ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Database Configuration
POSTGRES_DB=essivi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=essivi_analytics

# Django Configuration
# Generate a new SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# Traefik Proxy (for Docker setup)
USE_X_FORWARDED_HOST=True

# Redis (optional, for production)
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================================
# FRONTEND ENVIRONMENT VARIABLES
# ===================================
# Create frontend/.env.local and add:
# NEXT_PUBLIC_API_URL=http://localhost/api
# NEXT_PUBLIC_WS_URL=ws://localhost/ws

# ===================================
# PRODUCTION NOTES
# ===================================
# For production deployment:
# 1. Set DEBUG=False
# 2. Generate strong SECRET_KEY
# 3. Use strong database passwords
# 4. Configure proper ALLOWED_HOSTS
# 5. Set up SSL/TLS certificates
# 6. Configure proper CORS origins
